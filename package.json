{
  "name": "d500-workbench",
  "private": true,
  "version": "0.6.0-beta.2",
  "type": "module",
  "license": "GPL-3.0-only",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && node --test scripts/*.test.mjs",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "prebuild": "npm run prepare:radios",
    "predev": "npm run prepare:radios",
    "prepare:radios": "node scripts/package-radio-core.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "fflate": "^0.8.3",
    "lucide-react": "^1.62.0",
    "pyodide": "314.0.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "xlsx": "file:vendor/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "author": "BA7KTC / JukZeon",
  "description": "Browser-based radio programming workbench for D500, Baofeng UV-5R / UV-5RH and Quansheng UV-K5 / K6.",
